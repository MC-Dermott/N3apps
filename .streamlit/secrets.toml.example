# Copy this file to .streamlit/secrets.toml and fill in real values.
# .streamlit/secrets.toml is gitignored — never commit real credentials.
#
# N3apps shares ONE Supabase project with N5apps (both maths). Use the SAME
# SUPABASE_URL/SUPABASE_KEY that N5apps' own .streamlit/secrets.toml already
# has — students then log in with the same account on either app, and each
# app's dashboards/heatmaps only show its own subject's data (see
# core/db/tracker.py's SUBJECT constant and supabase_schema.sql's migration).

SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-anon-key"

# Signup code that grants the "teacher" role instead of "student". Can be the
# same code N5apps uses, or a different one — the role is shared either way.
TEACHER_CODE = "change-me"

# Optional: log in as this existing user, bypassing the password check, by
# visiting the app with ?admin_key=<ADMIN_KEY>. Leave both blank to disable.
ADMIN_KEY = ""
ADMIN_USERNAME = ""
